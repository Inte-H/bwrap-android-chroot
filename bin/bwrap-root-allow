#!/bin/bash
# Lets sandboxed commands reach files that only your account can reach: read for a file (and run
# for a program), read and list for a directory, and passage through each of your directories
# on the way to it, links included. Run it as the Claude Code account; it changes only files that
# account owns, and refuses a path that runs through a directory sandboxed commands can change.
#   bwrap-root-allow [-q] [-w <file>] <path>...
#   -w  appends every path it looked at to <file>, one per line
set -u
bin=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
. "$bin/../lib/bwrap-root/config"
looked=
while getopts qw: o; do
  case $o in
    q) exec >/dev/null 2>&1 ;;
    w) looked=$OPTARG ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))
(($#)) || { echo "usage: bwrap-root-allow [-q] [-w <file>] <path>..." >&2; exit 2; }
me=$(id -un)
sbx_group=$(id -gn "$SBX_USER") || exit 1
rc=0
declare -A written=() named=()

# One line per path, in argument order: owner, whether sandboxed commands can change its entries,
# whether they can pass through it, what the sandbox account may do with it now, and the mask (or
# the group permissions when there is no ACL)
acl_info() { # acl_info <path>...
  getfacl -p -- "$@" 2>/dev/null | awk -v u="$SBX_USER" -v g="$sbx_group" '
    function both(p, m,   r, i, c) {
      if (m == "") return p
      for (i = 1; i <= 3; i++) { c = substr(p, i, 1); r = r ((c != "-" && substr(m, i, 1) == c) ? c : "-") }
      return r
    }
    function either(p, q,   r, i, c) {
      for (i = 1; i <= 3; i++) { c = substr(p, i, 1); r = r (c != "-" ? c : substr(q, i, 1)) }
      return r
    }
    function emit(   eff, writes, passes) {
      if (f == "") return
      if (own == u) eff = ou
      else if (e != "") eff = both(e, m)
      else if (grp == g || ge != "") eff = either(grp == g ? both(og, m) : "---", ge != "" ? both(ge, m) : "---")
      else eff = oth
      passes = (index(eff, "x") != 0)
      # An owner can always chmod its directory into a writable one
      writes = (own == u || (passes && index(eff, "w") != 0 && !sticky))
      printf "%s\t%d\t%d\t%s\t%s\n", own, writes, passes, eff, m != "" ? m : og
    }
    /^# file: / { emit(); f = 1; own = grp = ou = e = og = ge = m = oth = ""; sticky = 0; next }
    /^# owner: / { own = $3; next }
    /^# group: / { grp = $3; next }
    /^# flags: / { sticky = ($3 ~ /t/); next }
    { split($0, a, ":") }
    a[1] == "user" && a[2] == "" { ou = a[3] }
    a[1] == "user" && a[2] == u { e = substr(a[3], 1, 3) }
    a[1] == "group" && a[2] == "" { og = substr(a[3], 1, 3) }
    a[1] == "group" && a[2] == g { ge = substr(a[3], 1, 3) }
    a[1] == "mask" { m = a[3] }
    a[1] == "other" { oth = a[3] }
    END { emit() }'
}

# Gives the sandbox account its own entry with what it may do now plus want. A named entry hides
# what group and other allowed, so those rights go into it too, except w on a directory: there it
# only starts to work together with the x being added. The mask grows by want and by what every
# other user may already do, so a right a chmod masked off and others lack stays off
grant() { # grant <rwx subset> <path> <what it may do now> <mask>
  local b want=$1 path=$2 eff=$3 mask=$4 add= newmask=
  [[ -d $path && $want != *w* ]] && eff=${eff/w/-}
  for b in r w x; do
    [[ $want$eff == *$b* ]] && add+=$b
    [[ $want$eff$mask == *$b* ]] && newmask+=$b || newmask+=-
  done
  [[ $add == "${eff//-}" ]] && return
  if setfacl -n -P -m "u:$SBX_USER:$add,m::$newmask" -- "$path"; then
    echo "allowed   $add  $path"
  else
    rc=1
  fi
}

# Follows path one component at a time, as the kernel does, through any links. Sets final to the
# path it ends at, passed to the directories it searched, named to those of them it looked a name
# other than . or .. up in (a swapped entry there would change where the path goes), and links to
# "link<TAB>target" for each link it followed
walk() { # walk <path>
  local rest=$1 cur=/ part next target hops=0
  local -A seen=()
  [[ $rest == /* ]] || rest=$PWD/$rest
  passed=() links=()
  named=()
  while [[ -n $rest ]]; do
    if [[ $rest == */* ]]; then part=${rest%%/*}; rest=${rest#*/}; else part=$rest; rest=; fi
    [[ -n $part ]] || continue
    [[ -n ${seen[$cur]-} ]] || { seen[$cur]=1; passed+=("$cur"); }
    case $part in
      .) continue ;;
      ..) cur=${cur%/*}; cur=${cur:-/}; continue ;;
    esac
    named[$cur]=1
    next=${cur%/}/$part
    if [[ -L $next ]]; then
      ((++hops <= 40)) || { echo "bwrap-root-allow: $1: too many links" >&2; return 1; }
      target=$(readlink -- "$next")
      links+=("$next"$'\t'"$target")
      [[ $target == /* ]] && cur=/
      rest=$target${rest:+/$rest}
    else
      cur=$next
    fi
  done
  final=$cur
  [[ -e $final ]] || { echo "bwrap-root-allow: $1: no such file or directory" >&2; return 1; }
}

for path in "$@"; do
  walk "$path" || { rc=1; continue; }
  if [[ -n $looked ]]; then
    for p in "${passed[@]}" "$final" "${links[@]/#/@}"; do
      [[ -n ${written[$p]-} ]] || { written[$p]=1; printf '%s\n' "$p" >> "$looked"; }
    done
  fi
  mapfile -t info < <(acl_info "${passed[@]}" "$final")
  ((${#info[@]} == ${#passed[@]} + 1)) || { echo "bwrap-root-allow: $path: cannot read ACLs" >&2; rc=1; continue; }
  unsafe=
  for i in "${!passed[@]}"; do
    IFS=$'\t' read -r _ writes _ _ _ <<<"${info[i]}"
    ((writes)) && [[ -n ${named[${passed[i]}]-} ]] && { unsafe=${passed[i]}; break; }
  done
  if [[ -n $unsafe ]]; then
    echo "bwrap-root-allow: sandboxed commands can change $unsafe; leaving $path alone" >&2
    rc=1
    continue
  fi
  for i in "${!passed[@]}"; do
    [[ ${passed[i]} == "$final" ]] && continue
    IFS=$'\t' read -r owner _ passes eff mask <<<"${info[i]}"
    if ((passes)); then
      :
    elif [[ $owner == "$me" ]]; then
      grant x "${passed[i]}" "$eff" "$mask"
    else
      echo "bwrap-root-allow: ${passed[i]} is not yours and the sandbox account cannot pass through it" >&2
      rc=1
    fi
  done
  IFS=$'\t' read -r owner _ _ eff mask <<<"${info[-1]}"
  if [[ $owner != "$me" ]]; then
    echo "bwrap-root-allow: $final is not yours" >&2
    rc=1
  elif [[ -d $final || -x $final ]]; then
    grant rx "$final" "$eff" "$mask"
  else
    grant r "$final" "$eff" "$mask"
  fi
done
exit $rc
